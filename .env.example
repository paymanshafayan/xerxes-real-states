# =====================================================================
# Xerxes Real Estate - Environment Variables
# Copy to `.env` (do NOT commit .env)
# =====================================================================

# --- Database ---
DATABASE_URL=postgresql://user:pass@localhost:5432/xerxes

# --- Auth (JWT) ---
# Generate a long random string, e.g. `openssl rand -base64 48`
AUTH_SECRET=change-me-to-a-long-random-string

# --- Default manager bootstrap (first staff login) ---
DEFAULT_MANAGER_USER=manager
DEFAULT_MANAGER_PASS=manager123
DEFAULT_MANAGER_EMAIL=manager@xerxes.com

# Public base URL (used for building absolute media URLs in some contexts)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Payments (Stripe) — optional, can also be set from Admin > API Keys ---
# When unset, /api/payments falls back to a manual/demo flow (no real charge).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PK=
# Required to verify webhook calls from Stripe (Dashboard > Webhooks > signing secret)
STRIPE_WEBHOOK_SECRET=

# --- Email (SMTP) — optional, can also be set from Admin > API Keys ---
# When unset, emails are logged to the console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@xerxes.com

# --- Google Analytics — optional, can also be set from Admin > API Keys ---
NEXT_PUBLIC_GA_ID=

# --- Object storage (Cloudflare R2) — optional, enables direct mobile upload ---
# When unset, media is stored locally under /public/uploads (dev only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL where R2 objects are served, e.g. https://cdn.xerxes.com
R2_PUBLIC_URL=

# --- Translation & Speech-to-Text (OpenAI) — optional ---
# When unset, translation echoes source and transcription returns empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSLATE_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1

# --- Realtime chat (Ably) — optional ---
# When unset, the app uses HTTP polling + push notifications.
ABLY_API_KEY=

# --- Expo Push (for mobile notifications) — optional ---
EXPO_PUSH_ACCESS_TOKEN=
